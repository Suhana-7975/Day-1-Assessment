package Assesmentt;

import java.io.FileInputStream;
import java.io.IOException;
import java.time.Duration;
import java.util.HashMap;
import java.util.Map;
import java.util.Properties;

import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;

import org.testng.annotations.AfterClass;
import org.testng.annotations.BeforeClass;

public class Day11_Base {

	    protected WebDriver driver;
	    protected Properties p;
	    protected Day11_Loginpage lp;
	    protected Day11_Recuitementpage rp;
	    protected Day11_Vancancypage vp;
	    protected String vacancyName;
	    protected String jobTitle;
	    protected String description;
	    protected String hiringManager;
	    protected String numberOfPositions;

	    @BeforeClass
	    public void setup() throws IOException {
	        // PROPERTY FILE
	        FileInputStream f =new FileInputStream("./src/test/resources/DDT/Day6_testcase1.properties");
	        p = new Properties();
	        p.load(f);
	        String browser =p.getProperty("browser");
	        String url =p.getProperty("url");

	        // BROWSER
	        if (browser.equalsIgnoreCase("chrome")) {
	            // Avoid Change Password popup
	            ChromeOptions settings =new ChromeOptions();
	            Map<String, Object> prefs =new HashMap<>();
	            prefs.put("profile.password_manager_leak_detection",false);
	            settings.setExperimentalOption("prefs",prefs);
	            driver =new ChromeDriver(settings);
	        }

	        driver.manage().window().maximize();
	        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
	        driver.get(url);

	        // POM OBJECT CREATION
	        lp = new Day11_Loginpage(driver);
	        rp = new Day11_Recuitementpage(driver);
	        vp = new Day11_Vancancypage(driver);

	        // EXCEL FILE
	        FileInputStream excel =new FileInputStream("./src/test/resources/DDT/Day6_testcase.xlsx");
	        Workbook wb =WorkbookFactory.create(excel);
	        Sheet s = wb.getSheet("Sheet2");
	        vacancyName = s.getRow(1).getCell(0).getStringCellValue();
	        jobTitle = s.getRow(1).getCell(1).getStringCellValue();
	        description =s.getRow(1).getCell(2).getStringCellValue();
	        hiringManager =s.getRow(1).getCell(3).getStringCellValue();
	        numberOfPositions = String.valueOf((int) s.getRow(1).getCell(4).getNumericCellValue());
    
	    }

	    @AfterClass
	    public void closeBrowser() {
	        driver.quit();
	    }

}

