package Assessment;

import org.testng.Assert;
import org.testng.annotations.Test;

import Assesmentt.Day11_Base1;

public class Day11_testcase1 extends Day11_Base1 {

	@Test(priority = 1)
	public void editEmployeeDetails() throws InterruptedException {

		// LOGIN
		lp.enterUsername(p.getProperty("username"));
		lp.enterPassword(p.getProperty("password"));
		lp.clickLogin();
		Thread.sleep(2000);

		// MY INFO
		mp.clickMyInfo();
		Thread.sleep(2000);

		// EDIT DETAILS
		mp.enterFirstName(firstName);
		mp.enterLastName(lastName);
		mp.enterEmployeeId(employeeId);
		Thread.sleep(1000);

		// SAVE
		mp.clickSave();
		Thread.sleep(2000);

		System.out.println("Employee details updated successfully");

		// LOGOUT
		lp.clickUserDropdown();
		lp.clickLogout();
		Thread.sleep(2000);
	}


	@Test(priority = 2, dependsOnMethods = "editEmployeeDetails")
	public void verifyEmployeeDetails() throws InterruptedException {

		// LOGIN AGAIN
		lp.enterUsername(p.getProperty("username"));
		lp.enterPassword(p.getProperty("password"));
		lp.clickLogin();
		Thread.sleep(2000);

		// MY INFO
		mp.clickMyInfo();
		Thread.sleep(2000);

		// VERIFY FIELDS ARE DISPLAYED
		Assert.assertTrue(mp.isFirstNameDisplayed());
		Assert.assertTrue(mp.isLastNameDisplayed());
		Assert.assertTrue(mp.isEmployeeIdDisplayed());

		// VERIFY UPDATED DETAILS
		Assert.assertEquals(mp.getFirstName(), firstName);
		Assert.assertEquals(mp.getLastName(), lastName);
		Assert.assertEquals(mp.getEmployeeId(), employeeId);

		System.out.println("Employee details verified successfully");

		// LOGOUT
		lp.clickUserDropdown();
		lp.clickLogout();
		Thread.sleep(2000);
	}
}
