public class Day10_testcase1 extends Day10_Base {
  
    // TEST METHOD 1

    @Test(priority = 1)
    public void loginTest() throws InterruptedException {

        String username =p.getProperty("username");
        String password = p.getProperty("password");

        // Login
        lp.enterUsername(username);
        lp.enterPassword(password);
        lp.clickLogin();
        Thread.sleep(2000);
        
        // Verify Products Page
        if (pp.verifyProductsPage()) {
            System.out.println("Products page is displayed");
        } else {
            System.out.println("Products page is NOT displayed");
        }
    }

    // TEST METHOD 2

    @Test(priority = 2, dependsOnMethods = "loginTest")
    public void orderPlacementTest() throws InterruptedException {
        // Add Sauce Labs Backpack
        pp.addBackpack();
        // Verify Cart Contains 1 Item
        if (pp.getCartCount().equals("1")) {
            System.out.println("Cart contains 1 item");
        } else {
            System.out.println("Cart does not contain 1 item");
        }
        
        // Open Cart
        pp.clickCart();
        Thread.sleep(2000);

        // Verify Backpack is Displayed
        if (cp.verifyBackpack()) {
            System.out.println("Sauce Labs Backpack is displayed");
        } else {
            System.out.println("Sauce Labs Backpack is NOT displayed");
        }
        
        // Click Checkout
        cp.clickCheckout();
        Thread.sleep(2000);

        // Enter First Name
        chp.enterFirstName(firstName);

        // Enter Last Name
        chp.enterLastName(lastName);

        // Enter Postal Code
        chp.enterPostalCode(postalCode);

        // Click Continue
        chp.clickContinue();
        Thread.sleep(2000);
        // Verify Checkout Overview Page
        if (cop.verifyCheckoutOverview()) {
            System.out.println("Checkout: Overview page is displayed");
        } else {
            System.out.println("Checkout: Overview page is NOT displayed");
        }     

        // Click Finish
        cop.clickFinish();

        // Verify Success Message
        if (cop.verifySuccessMessage()) {
            System.out.println("Thank you for your order!");
        } else {
            System.out.println("Order was not successful");
        }
    }
}
