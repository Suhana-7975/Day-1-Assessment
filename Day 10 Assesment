//Base Class

public class Day10_Base {
	protected WebDriver driver;
	protected Properties p;
	protected LoginPage lp;
	protected ProductsPage pp;
	protected CartPage cp;
	protected CheckoutPage chp;
	protected CheckoutOverviewPage cop;
	protected String firstName;
	protected String lastName;
	protected String postalCode;
	 @BeforeClass
	    public void setup() throws IOException {

	        // PROPERTY FILE
	        FileInputStream f =new FileInputStream("./src/test/resources/DDT/CommonData.properties");
	        p = new Properties();
	        p.load(f);
	        String browser =p.getProperty("browser");
	        String url =p.getProperty("url");
	        
	        // BROWSER
	        if (browser.equalsIgnoreCase("chrome")) {
	        	ChromeOptions settings = new ChromeOptions();
	            Map<String, Object> prefs = new HashMap<>();
	            prefs.put("profile.password_manager_leak_detection", false);
	            settings.setExperimentalOption("prefs", prefs);
	            driver = new ChromeDriver(settings);
	        }
	        driver.manage().window().maximize();
	        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
	        driver.get(url);

	        // POM OBJECT CREATION
	        lp = new LoginPage(driver);
	        pp = new ProductsPage(driver);
	        cp = new CartPage(driver);
	        chp = new CheckoutPage(driver);
	        cop = new CheckoutOverviewPage(driver);

	        // EXCEL FILE
	        FileInputStream excel =new FileInputStream("./src/test/resources/DDT/Day10_testcase.xlsx");
	        Workbook wb =WorkbookFactory.create(excel);
	        firstName = wb.getSheet("Sheet1").getRow(1).getCell(0).toString();
	        lastName = wb.getSheet("Sheet1").getRow(1).getCell(1).toString();
	        postalCode = wb.getSheet("Sheet1").getRow(1).getCell(2).toString();

	    }
	 @AfterClass
	    public void closeBrowser() {
	        driver.quit();
	    }
}

